# URL canônica (metadata, sitemap, IndexNow)
NEXT_PUBLIC_SITE_URL=https://www.echannel.com.br

# IndexNow — gere uma chave UUID; arquivo servido em /{INDEXNOW_API_KEY}.txt
INDEXNOW_API_KEY=
# Opcional: exige Authorization: Bearer {secret} no POST /api/indexnow
INDEXNOW_SUBMIT_SECRET=

# Checkout Base Commerce (Epic 5) — ver docs/CHECKOUT-BASE-COMMERCE.md
NEXT_PUBLIC_BC_CHECKOUT_BASE_URL=

# Proxy /base-commerce/* → deploys Vercel (ver docs/BASE-COMMERCE-REWRITES.md)
# BASE_COMMERCE_API_ORIGIN=https://base-commerce-api.vercel.app
# BASE_COMMERCE_ADMIN_ORIGIN=https://base-commerce-admin.vercel.app
# BASE_COMMERCE_STOREFRONT_ORIGIN=https://base-commerce-storefront.vercel.app
